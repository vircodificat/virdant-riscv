//! Top-level SoC wrapper.
//!
//! Instantiates the CPU core, a Wishbone-attached RAM, a UART, and an SPI
//! flash controller, connected via a Wishbone address decoder with the
//! following memory map:
//!
//!   0x2000_0000  SPI
//!   0x4000_0000  UART
//!   0x8000_0000  RAM

import cpu
import mem
import spi
import uart
import wishbone

//> Top module: the outermost entity of the design.
export mod Top {
    incoming clock : Clock {
        cpu.clock := it
        mem.clock := it
        uart_dev.clock := it
        spi_flash.clock := it
    }
    incoming reset : Reset {
        cpu.reset := it
        uart_dev.reset := it
        spi_flash.reset := it
    }

    client socket spi of spi::Spi
    client socket uart of uart::Uart

    reg cycle : Word[32] on clock {
        it <= when {
            case reset => 0w32
            else => it + 1w32
        }
    }

    //> CPU core instance.
    mod cpu of cpu::Cpu {}

    //> Wishbone address decoder.
    //>
    //> Routes transactions by comparing the top 3 address bits against
    //> each slave's base:
    //>   0x2 → SPI  (0x2000_0000)
    //>   0x4 → UART (0x4000_0000)
    //>   0x8 → RAM  (0x8000_0000)
    //>
    mod mux13 of wishbone::WbMux13 {
        it.client_0 :=: cpu.mem

        it.server_0 :=: spi_flash.wb
        it.server_1 :=: uart_dev.wb
        it.server_2 :=: mem.wb
    }

    //> Return code from the CPU (register a0 value at EBREAK).
    outgoing return_code : Word[32] {
        it := cpu.return_code
    }

    //> RAM instance (Wishbone-attached).
    mod mem of mem::WbMem

    //> UART instance (Wishbone-attached).
    mod uart_dev of uart::WbUart {
        uart     :=: it.uart
    }

    //> SPI flash controller instance.
    mod spi_flash of spi::WbSpiFlash {
        spi         :=: it.spi
    }

    //> Finish indicator: asserted when the CPU reaches the Breaked state.
    outgoing fin : Bit {
        it := cpu.is_breaked
    }
}
