import cpu
import mem

export mod Top {
    incoming clock : Clock
    incoming reset : Reset

    reg cycle : Word[32] on clock
    cycle <= if reset { 0w32 } else { cycle + 1w32 }

    mod cpu of cpu::Cpu {
        it.clock := clock
        it.reset := reset
        it.mem :=: mem.wb
    }

    mod mem of mem::WbMem {
        it.clock := clock
    }

    outgoing fin : Bit {
        it := cpu.is_break
    }
}
