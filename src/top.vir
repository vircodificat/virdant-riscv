import cpu
import mem

export mod Top {
    incoming clock : Clock
    incoming reset : Bit

    reg cycle : Word[32] on clock
    cycle <= if reset { 0w32 } else { cycle + 1w32 }

    mod cpu of cpu::Cpu {
        it.clock := clock
        it.reset := reset

        instr_mem.wb  :=: it.instr_mem
        mem.wb        :=: it.mem
    }

    mod mem of mem::WbMem {
        it.clock := clock
    }

    mod instr_mem of mem::WbRom

    outgoing fin : Bit {
        it := cpu.is_break
    }
}
