//! Top-level SoC wrapper.
//!
//! Instantiates the CPU core, a Wishbone-attached RAM, and an SPI
//! flash controller, connected via a Wishbone address decoder with the
//! following memory map:
//!
//!   0x2000_0000  SPI
//!   0x8000_0000  RAM

import cpu
import mem
import spi
import wishbone

/// Top module: the outermost entity of the design.
export mod Top {
    /// Global clock input.
    incoming clock : Clock
    /// Global reset input (active-high).
    incoming reset : Reset

    // --- SPI pins (exposed at the top level) ---
    /// SPI slave data input (MISO).
    incoming spi_di : Bit

    /// Cycle counter. Increments each clock cycle.
    reg cycle : Word[32] on clock
    // Increment cycle counter every cycle.
    cycle <= if reset { 0w32 } else { cycle + 1w32 }

    /// CPU core instance.
    mod cpu of cpu::Cpu {
        it.clock := clock
        it.reset := reset
    }

    /// Wishbone address decoder.
    ///
    /// Routes transactions by comparing the top address nybble against
    /// each slave's base:
    ///   0x2 → SPI  (0x2000_0000)
    ///   0x8 → RAM  (0x8000_0000)
    ///
    /// Unmapped addresses produce an error response.  To add a new
    /// device at 0x4000_0000, uncomment slave_2 in WbAddrMuxNybble.
    mod wb_decoder of wishbone::WbAddrMuxNybble {
        it.clock    := clock
        it.reset    := reset
        it.master_0 :=: cpu.mem
    }

    /// Return code from the CPU (register a0 value at EBREAK).
    outgoing return_code : Word[32] {
        it := cpu.return_code
    }

    /// RAM instance (Wishbone-attached).
    mod mem of mem::WbMem {
        it.clock := clock
        it.wb    :=: wb_decoder.slave_1
    }

    /// SPI flash controller instance.
    mod spi_ctrl of spi::SpiFlash {
        it.clock    := clock
        it.reset    := reset
        it.wb       :=: wb_decoder.slave_0
        it.spi.di   := spi_di
    }

    /// SPI chip-select (active-low).
    outgoing spi_cs : Bit {
        it := spi_ctrl.spi.cs
    }
    /// SPI serial clock.
    outgoing spi_clk : Bit {
        it := spi_ctrl.spi.clk
    }
    /// SPI master data output (MOSI).
    outgoing spi_do : Bit {
        it := spi_ctrl.spi.do
    }

    /// Finish indicator: asserted when the CPU reaches the Breaked state.
    outgoing fin : Bit {
        it := cpu.is_breaked
    }
}
