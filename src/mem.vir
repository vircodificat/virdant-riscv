import wishbone

mod WbMem {
    incoming clock : Clock
    server socket wb of wishbone::Wishbone {
        it.ack    := it.stb
        it.err    := false

        unused it.sel
    }

    mod mem of Mem {
        it.clock   := clock
        it.addr    := wb.adr
        it.data_in := wb.dat_wr
        it.write   := wb.cyc && wb.stb && wb.we
        wb.dat_rd  := it.data_out
        it.read    := wb.cyc && wb.stb && !wb.we
    }
}

mod WbRom {
    server socket wb of wishbone::Wishbone {
        rom.addr := it.adr
        it.dat_rd := if it.cyc { rom.instr } else { 0 }
        it.ack := it.stb
        it.err := false

        unused it.we
        unused it.dat_wr
        unused it.sel
    }

    mod rom of Rom
}

ext mod Mem {
    incoming clock : Clock
    incoming addr     : Word[32]
    outgoing data_out : Word[32]
    incoming data_in  : Word[32]
    incoming write  : Bit
    incoming read  : Bit
}

ext mod Csrs {
    incoming clock : Clock
    incoming addr     : Word[12]
    incoming data_in  : Word[32]
    outgoing data_out : Word[32]
    incoming read_and_write  : Bit
}

ext mod Rom {
    incoming addr : Word[32]
    outgoing instr : Word[32]
}
