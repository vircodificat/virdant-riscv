enum type Opcode width 7 {
    BRANCH = 99
    JALR   = 103
    JAL    = 111
    OP_IMM = 19
    OP     = 51
    LUI    = 55
    AUIPC  = 23
    LOAD   = 3
    SYSTEM = 115
    STORE  = 35
    FENCE  = 15
}

enum type AluOpcode width 7 {
    Zero = 0
    Add = 1
    Sub = 2
    And = 3
    Or  = 4
    Xor = 5
    Eq  = 6
    Neq = 7
    Lt  = 8
    Gte = 9
    Ltu  = 10
    Gteu = 11
    Sll = 12
}

enum type CpuStage width 4 {
    Reset     = 0b0001
    Fetching  = 0b0010
    Execute   = 0b0100
    Writeback = 0b1000
}

enum type Csr width 12 {
    MStatus  = 0x300
    MIsa     = 0x301
    MIe      = 0x304
    MTvec    = 0x305
    MScratch = 0x340
    MEpc     = 0x341
    MCause   = 0x342
    MTval    = 0x343
    MIp      = 0x344
}
