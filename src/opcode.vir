enum type Opcode width 7 {
    BRANCH = 99
    JALR   = 103
    JAL    = 111
    OP_IMM = 19
    OP     = 51
    LUI    = 55
    AUIPC  = 23
    LOAD   = 3
    SYSTEM = 115
    STORE  = 35
    FENCE  = 15
}

enum type AluOpcode width 8 {
    Zero  = 0
    Add   = 1
    Sub   = 2
    And   = 3
    Or    = 4
    Xor   = 5
    Eq    = 6
    Neq   = 7
    Lt    = 8
    Gte   = 9
    Ltu   = 10
    Gteu  = 11
    Sll   = 12
    Clear = 13
    PassA = 14
    Srl   = 15
    Sra   = 16
}

enum type CpuStage width 5 {
    Reset     = 0b00001
    Fetching  = 0b00010
    Execute   = 0b00100
    Writeback = 0b01000
    Breaked   = 0b10000
}

enum type Csr width 12 {
    MStatus   = 0x300
    MIsa      = 0x301
    MIe       = 0x304
    MTvec     = 0x305
    MScratch  = 0x340
    MEpc      = 0x341
    MCause    = 0x342
    MTval     = 0x343
    MIp       = 0x344
    MVendorId = 0xF11
    MArchId   = 0xF12
    MImpId    = 0xF13
    MHartId   = 0xF14
}

enum type System width 12 {
    Ecall  = 0x000
    Ebreak = 0x001
    Wfi    = 0x105
    Mret   = 0x302
    Sret   = 0x102
}
