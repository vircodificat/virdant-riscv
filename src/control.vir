import opcode

enum type AluSourceA width 2 {
    Rs1 = 0b01
    Pc  = 0b10
}

enum type AluSourceB width 2 {
    Rs2 = 0b01
    Imm = 0b10
}

enum type RdSource width 5 {
    Mem       = 0b00001w5
    Imm       = 0b00010w5
    PcPlusImm = 0b00100w5
    PcPlus4   = 0b01000w5
    AluZ      = 0b10000w5
}

mod Control {
    incoming opcode : opcode::Opcode
    incoming funct3 : Word[3]
    incoming funct7 : Word[7]
    incoming alu_z  : Word[32]

    match opcode {
        case #BRANCH => {
            mem_write     := false
            rf_write      := false
            take_branch   := alu_z[0]
            alu_source_a  := #Rs1
            alu_source_b  := #Rs2
            rd_source     := #AluZ
            alu_op        := #Zero
        }
        case #JALR => {
            mem_write     := false
            rf_write      := true
            take_branch   := true
            alu_source_a  := #Rs1
            alu_source_b  := #Imm
            rd_source     := #PcPlus4
            alu_op        := #Zero
        }
        case #JAL => {
            mem_write     := false
            rf_write      := true
            take_branch   := true
            alu_source_a  := #Rs1
            alu_source_b  := #Rs2
            rd_source     := #PcPlus4
            alu_op        := #Zero
        }
        case #OP_IMM => {
            mem_write     := false
            rf_write      := true
            take_branch   := false
            alu_source_a  := #Rs1
            alu_source_b  := #Imm
            rd_source     := #AluZ
            alu_op        := alu_op_from_funct37.op
        }
        case #OP => {
            mem_write     := false
            rf_write      := true
            take_branch   := false
            alu_source_a  := #Rs1
            alu_source_b  := #Rs2
            rd_source     := #AluZ
            alu_op        := alu_op_from_funct37.op
        }
        case #LUI => {
            mem_write     := false
            rf_write      := true
            take_branch   := false
            alu_source_a  := #Rs1
            alu_source_b  := #Imm
            rd_source     := #Imm
            alu_op        := #Zero
        }
        case #AUIPC => {
            mem_write     := false
            rf_write      := true
            take_branch   := false
            alu_source_a  := #Pc
            alu_source_b  := #Imm
            rd_source     := #PcPlusImm
            alu_op        := #Add
        }
        case #LOAD => {
            mem_write     := false
            rf_write      := true
            take_branch   := false
            alu_source_a  := #Rs1
            alu_source_b  := #Imm
            rd_source     := #Mem
            alu_op        := #Add
        }
        case #SYSTEM => {
            mem_write     := false
            rf_write      := false
            take_branch   := false
            alu_source_a  := #Rs1
            alu_source_b  := #Rs2
            rd_source     := #AluZ
            alu_op        := #Zero
        }
        case #STORE => {
            mem_write     := true
            rf_write      := false
            take_branch   := false
            alu_source_a  := #Rs1
            alu_source_b  := #Imm
            rd_source     := #AluZ
            alu_op        := #Add
        }
        case #FENCE => {
            mem_write     := false
            rf_write      := false
            take_branch   := false
            alu_source_a  := #Rs1
            alu_source_b  := #Rs2
            rd_source     := #AluZ
            alu_op        := #Zero
        }
    }

    mod alu_op_from_funct37 of AluOpFromFunct37 {
        it.funct3 := funct3
        it.funct7 := if opcode == #OP {
            funct7 // For opcode OP, there is a funct7...
        } else {
            0w7 // But for opcode OP-IMM, there isn't, and we pass 0 instead
        }
    }

    outgoing mem_strobe : Bit {
        it := is_fetching || opcode == #LOAD || opcode == #STORE
    }

    outgoing mem_write : Bit
    outgoing rf_write : Bit
    outgoing take_branch : Bit
    outgoing alu_source_a : AluSourceA
    outgoing alu_source_b : AluSourceB
    outgoing rd_source : RdSource
    outgoing alu_op : opcode::AluOpcode

    outgoing mem_sel : Word[4] {
        it := 0b1111w4
    }

    wire is_fetching : Bit {
        it := stage == #Fetching
    }
    incoming stage : opcode::CpuStage

    outgoing is_break : Bit {
        it :=
            opcode == #SYSTEM &&
            funct3 == 0b000 &&
            stage == #Writeback
    }
}

mod AluOpFromFunct37 {
    incoming funct3 : Word[3]
    incoming funct7 : Word[7]

    outgoing op : opcode::AluOpcode {
        it := match funct3 {
            case 0 =>
                if funct7[5] {
                    #Sub
                } else {
                    #Add
                }
            case 1 => #Sll
            case 2 => #Zero // TODO: SLT
            case 3 => #Zero // TODO: SLTU
            case 4 => #Xor
            case 5 =>
                if funct7[5] { // TODO: SRA
                    #Zero
                } else { // TODO: SRL
                    #Zero
                }
            case 6 => #Or
            case 7 => #And
        }
    }
}
