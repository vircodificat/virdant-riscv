import opcode

enum type AluSourceA width 3 {
    Rs1 = 0b001
    Pc  = 0b010
    Csr = 0b100
}

enum type AluSourceB width 2 {
    Rs2 = 0b01
    Imm = 0b10
}

enum type RdSource width 6 {
    Mem       = 0b000001w6
    Imm       = 0b000010w6
    PcPlusImm = 0b000100w6
    PcPlus4   = 0b001000w6
    AluZ      = 0b010000w6
    Csr       = 0b100000w6
}

mod Control {
    incoming opcode : opcode::Opcode
    incoming funct3 : Word[3]
    incoming funct7 : Word[7]
    incoming alu_z  : Word[32]

    match opcode {
        case #BRANCH => {
            mem_write     := false
            rf_write      := false
            take_branch   := alu_z[0]
            csr_rw        := false
            alu_source_a  := #Rs1
            alu_source_b  := #Rs2
            rd_source     := #AluZ
            alu_op        := match funct3 {
                case 0 => #Eq
                case 1 => #Neq
                case 2 => #Zero
                case 3 => #Zero
                case 4 => #Lt
                case 5 => #Gte
                case 6 => #Ltu
                case 7 => #Gteu
            }
        }
        case #JALR => {
            mem_write     := false
            rf_write      := true
            take_branch   := true
            csr_rw        := false
            alu_source_a  := #Rs1
            alu_source_b  := #Imm
            rd_source     := #PcPlus4
            alu_op        := #Zero
        }
        case #JAL => {
            mem_write     := false
            rf_write      := true
            take_branch   := true
            csr_rw        := false
            alu_source_a  := #Rs1
            alu_source_b  := #Rs2
            rd_source     := #PcPlus4
            alu_op        := #Zero
        }
        case #OP_IMM => {
            mem_write     := false
            rf_write      := true
            take_branch   := false
            csr_rw        := false
            alu_source_a  := #Rs1
            alu_source_b  := #Imm
            rd_source     := #AluZ
            alu_op        := alu_op_from_funct37.op
        }
        case #OP => {
            mem_write     := false
            rf_write      := true
            take_branch   := false
            csr_rw        := false
            is_break      := false
            alu_source_a  := #Rs1
            alu_source_b  := #Rs2
            rd_source     := #AluZ
            alu_op        := alu_op_from_funct37.op
        }
        case #LUI => {
            mem_write     := false
            rf_write      := true
            take_branch   := false
            csr_rw        := false
            is_break      := false
            alu_source_a  := #Rs1
            alu_source_b  := #Imm
            rd_source     := #Imm
            alu_op        := #Zero
        }
        case #AUIPC => {
            mem_write     := false
            rf_write      := true
            take_branch   := false
            csr_rw        := false
            is_break      := false
            alu_source_a  := #Pc
            alu_source_b  := #Imm
            rd_source     := #PcPlusImm
            alu_op        := #Add
        }
        case #LOAD => {
            mem_write     := false
            rf_write      := true
            take_branch   := false
            csr_rw        := false
            is_break      := false
            alu_source_a  := #Rs1
            alu_source_b  := #Imm
            rd_source     := #Mem
            alu_op        := #Add
        }
        case #SYSTEM => {
            mem_write     := false
            rf_write      := false
            take_branch   := false
            csr_rw        := funct3 != 0b000
            is_break      := funct3 == 0b000
            alu_source_a  := #Csr
            alu_source_b  := #Imm
            rd_source     := #AluZ
            alu_op        := match funct3 {
                case 0b001 => #PassA //CsrRw
                case 0b010 => #Or    //CsrRs
                case 0b011 => #Clear //CsrRc
                case 0b101 => #PassA //CsrRwi
                case 0b110 => #Or    //CsrRsi
                case 0b111 => #Clear //CsrRci
                else => dontcare
            }
        }
        case #STORE => {
            mem_write     := true
            rf_write      := false
            take_branch   := false
            csr_rw        := false
            is_break      := false
            alu_source_a  := #Rs1
            alu_source_b  := #Imm
            rd_source     := #AluZ
            alu_op        := #Add
        }
        case #FENCE => {
            mem_write     := false
            rf_write      := false
            take_branch   := false
            csr_rw        := false
            is_break      := false
            alu_source_a  := #Rs1
            alu_source_b  := #Rs2
            rd_source     := #AluZ
            alu_op        := dontcare
        }
    }

    mod alu_op_from_funct37 of AluOpFromFunct37 {
        it.funct3 := funct3
        it.funct7 := if opcode == #OP {
            funct7 // For opcode OP, there is a funct7...
        } else {
            0w7 // But for opcode OP-IMM, there isn't, and we pass 0 instead
        }
    }

    outgoing mem_strobe : Bit {
        it := is_fetching || opcode == #LOAD || opcode == #STORE
    }

    outgoing mem_write      : Bit
    outgoing rf_write       : Bit
    outgoing csr_rw         : Bit
    outgoing take_branch    : Bit
    outgoing alu_source_a   : AluSourceA
    outgoing alu_source_b   : AluSourceB
    outgoing rd_source      : RdSource
    outgoing alu_op         : opcode::AluOpcode

    outgoing mem_sel : Word[4] {
        it := 0b1111w4
    }

    wire is_fetching : Bit {
        it := stage == #Fetching
    }
    incoming stage : opcode::CpuStage

    outgoing is_break : Bit
}

mod AluOpFromFunct37 {
    incoming funct3 : Word[3]
    incoming funct7 : Word[7]

    outgoing op : opcode::AluOpcode {
        it := match funct3 {
            case 0 =>
                if funct7[5] {
                    #Sub
                } else {
                    #Add
                }
            case 1 => #Sll
            case 2 => dontcare // TODO: SLT
            case 3 => dontcare // TODO: SLTU
            case 4 => #Xor
            case 5 =>
                if funct7[5] { // TODO: SRA
                    dontcare
                } else { // TODO: SRL
                    dontcare
                }
            case 6 => #Or
            case 7 => #And
        }
    }
}
