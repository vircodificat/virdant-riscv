import opcode

mod Control {
    incoming opcode : opcode::Opcode
    incoming funct3 : Word[3]
    incoming funct7 : Word[7]

    outgoing mem_write : Bit {
        it := if opcode == #STORE {
            true
        } else {
            false
        }
    }

    outgoing rf_write : Bit {
        it := match opcode {
            case #OP_IMM => true
            case #OP => true
            case #AUIPC => true
            case #LUI => true
            case #JALR => true
            case #JAL => true
            case #LOAD => true
            else => false
        }
    }

    outgoing latch_rf_from_mem : Bit {
        it := if opcode == #LOAD {
            true
        } else {
            false
        }
    }

    outgoing alu_source_imm : Bit {
        it := match opcode {
            case #OP_IMM => true
            case #LUI => true
            case #LOAD => true
            case #STORE => true
            else => false
        }
    }

    outgoing alu_op : opcode::AluOpcode {
        it := match opcode {
            case #AUIPC => #Add
            case #LOAD => #Add
            case #STORE => #Add
            case #OP =>
                if funct3 == 0 {
                    if funct7[5] {
                        #Sub
                    } else {
                        #Add
                    }
                } else if funct3 == 1 { // SLL
                    #Zero
                } else if funct3 == 2 { // SLT
                    #Zero
                } else if funct3 == 3 { // SLTU
                    #Zero
                } else if funct3 == 4 { // XOR
                    #Xor
                } else if funct3 == 5 { // SRL/A
                    if funct7[5] { // SRA
                        #Zero
                    } else { // SRL
                        #Zero
                    }
                } else if funct3 == 6 { // OR
                    #Or
                } else if funct3 == 7 { // AND
                    #And
                } else {
                    #Zero
                }
            case #OP_IMM =>
                if funct3 == 0 {
                    #Add
                } else if funct3 == 1 { // SLL
                    #Zero
                } else if funct3 == 2 { // SLT
                    #Zero
                } else if funct3 == 3 { // SLTU
                    #Zero
                } else if funct3 == 4 { // XOR
                    #Xor
                } else if funct3 == 5 { // SRL/A
                    #Zero
                } else if funct3 == 6 { // OR
                    #Or
                } else if funct3 == 7 { // AND
                    #And
                } else {
                    #Zero
                }
            case #BRANCH =>
                if funct3 == 0w3 { // BEQ
                    #Eq
                } else if funct3 == 1w3 { // BNE
                    #Neq
                } else if funct3 == 4w3 { // BLT
                    #Lt
                } else if funct3 == 5w3 { // BGE
                    #Gte
                } else if funct3 == 6w3 { // BLTU
                    #Ltu
                } else if funct3 == 7w3 { // BGEU
                    #Gteu
                } else {
                    #Zero
                }
            else => #Zero
        }
    }
}
