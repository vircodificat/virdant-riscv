import rf
import alu
import control
import idecode
import wishbone

union type State {
    Reset()
    Fetching()
    Execute()
    Writeback()
}

mod Cpu {
    incoming clock : Clock
    incoming reset : Reset

    mod control of control::Control

    client socket instr_mem of wishbone::Wishbone {
        unused it.err

        it.adr    := pc
        it.sel    := 0b1111w4
        it.dat_wr := 0w32
        it.we     := false

        control.instr_mem_ack := it.ack
    }

    client socket mem of wishbone::Wishbone {
        unused it.err

        it.adr := alu.z
        it.sel := control.mem_sel
        it.dat_wr := rf.rs2_out

        it.we  := control.mem_write
        it.stb := control.mem_strobe
        it.cyc := control.mem_strobe
        control.mem_ack := it.ack
    }

    reg pc : Word[32] on clock {
        if reset {
            it <= 0w32
        } else if state == @Writeback() {
            it <= next_pc
        }
    }

    wire next_pc : Word[32] {
        it :=
            if control.take_branch {
                pc + idecode.imm
            } else if idecode.opcode == #JALR {
                rf.rs1_out + idecode.imm
            } else if idecode.opcode == #JAL {
               pc + idecode.imm
            } else {
                pc + 4
            }
    }

    reg instr : Word[32] on clock
    reg mem_buffer : Word[32] on clock

    reg state : State on clock {
        if reset {
            it <= @Reset()
        } else if !control.stall {
            match state {
                case @Reset() => {
                    it <= @Fetching()
                }
                case @Fetching() => {
                    it <= @Execute()
                    instr <= instr_mem.dat_rd
                }
                case @Execute() => {
                    it <= @Writeback()
                    mem_buffer <= mem.dat_rd
                }
                case @Writeback() => {
                    it <= @Fetching()
                }
            }
        }
    }

    control.is_fetching := match state {
        case @Fetching() => true
        else => false
    }

    mod idecode of idecode::IDecode {
        it.instr := instr

        control.funct3 := it.funct3
        control.funct7 := it.funct7
        control.opcode := it.opcode
    }

    mod rf of rf::Rf {
        it.clock := clock
        it.rd  := idecode.rd
        it.rs1 := idecode.rs1
        it.rs2 := idecode.rs2
        it.write := control.rf_write && state == @Writeback()

        it.rd_in  := match control.rd_source {
            case #Imm       => idecode.imm
            case #PcPlusImm => pc + idecode.imm
            case #PcPlus4   => pc + 4
            case #Mem       => mem_buffer
            case #AluZ      => alu.z
        }
    }

    mod alu of alu::Alu {
        it.op := control.alu_op

        it.a := match control.alu_source_a {
            case #Rs1 => rf.rs1_out
            case #Pc => pc
        }

        it.b := match control.alu_source_b {
            case #Rs2 => rf.rs2_out
            case #Imm => idecode.imm
        }

        control.alu_z := it.z
    }

    match state {
        case @Reset() => {
            instr_mem.cyc := true
            instr_mem.stb := true
        }
        case @Fetching() => {
            instr_mem.cyc := true
            instr_mem.stb := true
        }
        else => {
            instr_mem.cyc := false
            instr_mem.stb := false
        }
    }

    outgoing is_break : Bit {
        it :=
            idecode.opcode == #SYSTEM &&
            idecode.funct3 == 0b000 &&
            state == @Writeback()
    }
}
