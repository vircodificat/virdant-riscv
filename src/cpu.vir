//! This is the CPU core

import rf
import alu
import control
import idecode
import wishbone

pub enum type Halt {
    Fault
    Breaked
}

//> A RISC-V CPU core
//>
//> 3-stage, non-pipelined RV32I processor
pub mod Cpu {
    incoming clock : Clock
    incoming reset : Reset

    mod control of control::Control {
        it.stage := stage
    }

    //> Wishbone bus client socket for instruction fetch and data access.
    client socket mem of wishbone::Wishbone {
        unused it.err

        it.adr    := match stage {
            with #Fetching => pc
            with #Execute  => alu.z
            else           => dontcare
        }
        it.sel    := control.mem_sel
        it.dat_wr := match idecode.funct3[2..0] {
            with 0b00 let lo = rf.rs2_out[8..0]  => word(lo, lo, lo, lo)
            with 0b01 let hi = rf.rs2_out[16..0] => word(hi, hi)
            with 0b10 => rf.rs2_out
            else      => dontcare
        }
        it.we     := control.mem_write
        it.stb    := control.mem_strobe
        it.cyc    := control.mem_strobe

        control.mem_ack := it.ack
    }

    //> Program counter register.
    //>
    //> Reset to 0x20000000: execute-in-place from the SPI flash (the
    //> virt platform maps flash offset 0 there).  Updated in the
    //> Writeback stage: sequential increments by 4, or target address
    //> for branches, JAL, JALR, MRET.
    reg pc : Word[32] {
        it <= if {
            when reset => 0x20000000w32
            when stage == #Writeback if {
                when idecode.opcode == #JALR => rf.rs1_out + idecode.imm
                when control.take_branch => it + idecode.imm
                when idecode.opcode == #JAL => it + idecode.imm
                when control.is_mret => csrs.data_out
                else => it + 4
            }
            else => it
        }
    }

    //> Instruction word register. Fetched from memory in the Fetch stage.
    reg instr : Word[32] {
        it <= if {
            when !control.stall && stage == #Fetching => mem.dat_rd
            else => it
        }
    }

    //> Memory read-data buffer. Captured from the Wishbone bus in the Execute stage.
    reg mem_buffer : Word[32] {
        it <= if {
            when !control.stall && stage == #Execute => mem.dat_rd
            else => it
        }
    }

    //> Fault latch: set when an illegal instruction reaches Execute.
    //> While set, the pipeline freezes in place (stage reg stops
    //> advancing), so the faulting instruction is not re-executed and
    //> cpu.halt holds @Valid(#Fault) until reset.
    reg faulted : Bit {
        if {
            when reset {
                it <= false
            }
            when stage == #Execute && idecode.illegal_opcode {
                it <= true
            }
        }
    }

    //> Pipeline stage state machine.
    //>
    //> Transitions: Reset -> Fetching -> Execute -> Writeback -> (Breaked | Fetching).
    //> Stalls when `control.stall` is asserted, or permanently once
    //> `faulted` latches.
    //>
    //> Note: mem.adr is now driven combinatorially in the socket declaration,
    //> NOT inside this block, to avoid a deadlock where stall gates the
    //> address, which prevents ack, which keeps stall asserted.
    reg stage : opcode::CpuStage {
        if {
            when reset {
                it <= #Reset
            }
            when !control.stall && !faulted {
                match it {
                    with #Reset {
                        it <= #Fetching
                    }
                    with #Fetching {
                        it <= #Execute
                    }
                    with #Execute {
                        it <= #Writeback
                    }
                    with #Writeback if {
                        when control.is_break {
                            it <= #Breaked
                        }
                        else {
                            it <= #Fetching
                        }
                    }
                }
            }
        }
    }

    //> Instruction decoder sub-module.
    mod idecode of idecode::IDecode {
        it.instr := instr

        control.funct3  := it.funct3
        control.funct7  := it.funct7
        control.funct12 := it.funct12
        control.opcode  := it.opcode
    }

    //> Register file sub-module.
    mod rf of rf::Rf {
        it.clock := clock
        it.rd    := idecode.rd
        it.rs1   := idecode.rs1
        it.rs2   := if {
            when stage == #Breaked => 10w5 // a0, the return code
            else => idecode.rs2
        }
        it.write := control.rf_write && stage == #Writeback

        it.rd_in := match control.rd_source {
            with #Imm       => idecode.imm
            with #PcPlusImm => pc + idecode.imm
            with #PcPlus4   => pc + 4
            with #Mem       => mem_buffer_shifted
            with #AluZ      => alu.z
            with #Csr       => csrs.data_out
        }
    }

    //> Memory read-data alignment and sign/zero-extension.
    //>
    //> Selects the correct byte/halfword/word from `mem_buffer` based on
    //> the load address alignment (`alu.z[1:0]`) and applies signed or
    //> unsigned extension according to `funct3[2]`.
    wire mem_buffer_shifted : Word[32] {
        it := match idecode.funct3[2..0] {
            with 0b00 let byte = match alu.z[2..0] {
                with 0 => mem_buffer[ 8.. 0]
                with 1 => mem_buffer[16.. 8]
                with 2 => mem_buffer[24..16]
                with 3 => mem_buffer[32..24]
            } if {
                when control.unsigned_load => zext(byte : Word[8])
                else => sext(byte : Word[8])
            }
            with 0b01 let half = match alu.z[2..1] {
                with 0 => mem_buffer[16.. 0]
                with 1 => mem_buffer[32..16]
            } if {
                when control.unsigned_load => zext(half : Word[16])
                else => sext(half : Word[16])
            }
            with 0b10 => mem_buffer
            with 0b11 => dontcare
        }
    }

    //> ALU sub-module.
    mod alu of alu::Alu {
        it.op := control.alu_op

        it.a := match control.alu_source_a {
            with #Rs1 => rf.rs1_out
            with #Pc => pc
            with #Csr => csrs.data_out
        }

        it.b := match control.alu_source_b {
            with #Rs2 => rf.rs2_out
            with #Imm => idecode.imm
            with #Rs1 => rf.rs1_out
        }

        control.alu_z := it.z
    }

    //> CSR file sub-module.
    mod csrs of mem::Csrs {
        it.clock   := clock
        it.addr    := control.csr
        it.write   := control.csr_rw && stage == #Execute
        it.data_in := rf.rs1_out
    }

    //> Return code (register a0 value at the time of EBREAK).
    outgoing return_code : Word[32] {
        it := rf.rs2_out
    }

    //> Halted indicator: asserted while the CPU is frozen on a fault
    //> (illegal instruction reached Execute; held until reset), or
    //> when the CPU is in the Breaked state (EBREAK).  A garbage
    //> instruction word sitting in the instr register during a fetch
    //> — e.g. while booting from slow SPI flash — is not reported.
    outgoing halt : Valid[Halt] {
        it := if {
            when faulted => @Valid(#Fault)
            when stage == #Breaked => @Valid(#Breaked)
            else => @Invalid()
        }

    }
}
