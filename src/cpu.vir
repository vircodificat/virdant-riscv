import rf
import alu
import control
import idecode
import wishbone

mod Cpu {
    incoming clock : Clock
    incoming reset : Reset

    mod control of control::Control {
        it.stage := stage
    }

    client socket mem of wishbone::Wishbone {
        unused it.err

        it.sel := control.mem_sel
        it.dat_wr := rf.rs2_out

        it.we  := control.mem_write
        it.stb := control.mem_strobe
        it.cyc := control.mem_strobe
    }

    reg pc : Word[32] on clock {
        if reset {
            it <= 0x80000000w32
        } else if stage == #Writeback {
            if idecode.opcode == #JALR {
                it <= rf.rs1_out + idecode.imm
            } else if control.take_branch {
                it <= it + idecode.imm
            } else if idecode.opcode == #JAL {
                it <= it + idecode.imm
            } else if control.is_mret {
                it <= csrs.data_out
            } else {
                it <= it + 4
            }
        }
    }

    reg instr : Word[32] on clock
    reg mem_buffer : Word[32] on clock

    reg stage : opcode::CpuStage on clock {
        if reset {
            it <= #Reset
        } else if !stall {
            match stage {
                case #Reset => {
                    it <= #Fetching
                }
                case #Fetching => {
                    it <= #Execute
                    mem.adr := pc
                    instr <= mem.dat_rd
                }
                case #Execute => {
                    it <= #Writeback
                    mem.adr := alu.z
                    mem_buffer <= mem.dat_rd
                }
                case #Writeback => {
                    if control.is_break {
                        it <= #Breaked
                    } else {
                        it <= #Fetching
                    }
                }
                case #Breaked => {
                    mem.adr := dontcare
                }
            }
        }
    }

    wire stall : Bit {
        it := match stage {
            case #Fetching => !mem.ack
            case #Execute => idecode.opcode == #LOAD && !mem.ack
            else => false
        }
    }

    mod idecode of idecode::IDecode {
        it.instr := instr

        control.funct3   := it.funct3
        control.funct7   := it.funct7
        control.funct12  := it.funct12
        control.opcode   := it.opcode
    }

    mod rf of rf::Rf {
        it.clock := clock
        it.rd  := idecode.rd
        it.rs1 := idecode.rs1
        it.rs2 :=
            if stage == #Breaked {
                10w5 // a0, the return code
            } else {
                idecode.rs2
            }
        it.write := control.rf_write && stage == #Writeback

        it.rd_in  := match control.rd_source {
            case #Imm       => idecode.imm
            case #PcPlusImm => pc + idecode.imm
            case #PcPlus4   => pc + 4
            case #Mem       => mem_buffer_shifted
            case #AluZ      => alu.z
            case #Csr       => csrs.data_out
        }
    }

    wire mem_buffer_shifted : Word[32] {
        match idecode.funct3[2..0] {
            case 0b00 => {
                if control.unsigned_load {
                    it := zext((match alu.z[2..0] {
                        case 0 => mem_buffer[ 8.. 0]
                        case 1 => mem_buffer[16.. 8]
                        case 2 => mem_buffer[24..16]
                        case 3 => mem_buffer[32..24]
                    }) : Word[8])
                } else {
                    it := sext((match alu.z[2..0] {
                        case 0 => mem_buffer[ 8.. 0]
                        case 1 => mem_buffer[16.. 8]
                        case 2 => mem_buffer[24..16]
                        case 3 => mem_buffer[32..24]
                    }) : Word[8])
                }
            }
            case 0b01 => {
                if control.unsigned_load {
                     it:= zext((match alu.z[2..1] {
                         case 0 => mem_buffer[16.. 0]
                         case 1 => mem_buffer[32..16]
                        }) : Word[16])
                } else {
                     it:= sext((match alu.z[2..1] {
                         case 0 => mem_buffer[16.. 0]
                         case 1 => mem_buffer[32..16]
                        }) : Word[16])
                }
            }
            case 0b10 => {
                it := mem_buffer
            }
            case 0b11 => {
                it := dontcare
            }
        }
    }

    mod alu of alu::Alu {
        it.op := control.alu_op

        it.a := match control.alu_source_a {
            case #Rs1 => rf.rs1_out
            case #Pc => pc
            case #Csr => csrs.data_out
        }

        it.b := match control.alu_source_b {
            case #Rs2 => rf.rs2_out
            case #Imm => idecode.imm
            case #Rs1 => rf.rs1_out
        }

        control.alu_z := it.z
    }

    mod csrs of mem::Csrs {
        it.clock := clock
        it.addr := control.csr
        it.write := control.csr_rw && stage == #Execute
        it.data_in := rf.rs1_out
    }

    outgoing is_breaked : Bit {
        it := stage == #Breaked
    }

    outgoing return_code : Word[32] {
        it := rf.rs2_out
    }
}
