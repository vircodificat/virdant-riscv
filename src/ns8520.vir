mod Ns8520 {
    // A Channel
    incoming a_valid : Bit
    outgoing a_ready : Bit
    incoming a_opcode : Bit
    incoming a_param : Bit
    incoming a_size : Bit
    incoming a_source : Bit
    incoming a_addr : Bit
    incoming a_mask : Bit
    incoming a_data : Bit

    // D Channel
    outgoing d_valid : Bit
    incoming d_ready : Bit
    outgoing d_opcode : Bit
    outgoing d_param : Bit
    outgoing d_size : Bit
    outgoing d_source : Bit
    outgoing d_addr : Bit
    outgoing d_mask : Bit
    outgoing d_data : Bit

    a_ready  := false
    d_valid  := false
    d_opcode := false
    d_param  := false
    d_size   := false
    d_source := false
    d_addr   := false
    d_mask   := false
    d_data   := false
}
