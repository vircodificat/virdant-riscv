//> Wishbone bus socket.
//>
//> Standard Wishbone B.4 signals for a 32-bit data bus.
//> All signals are from the master's perspective.
pub socket Wishbone {
    //> Cycle start: the master asserts this for the duration of a bus transaction.
    cosi cyc : Bit
    //> Strobe: the master asserts this during the data phase.
    cosi stb : Bit
    //> Write enable: high for write, low for read.
    cosi we : Bit
    //> Address (32-bit byte address).
    cosi adr : Word[32]
    //> Write data.
    cosi dat_wr : Word[32]
    //> Byte-select mask (one hot per byte lane).
    cosi sel : Word[4]

    //> Acknowledge: the slave asserts this when the transfer is complete.
    //>
    //> May depend on any master signal: different slaves qualify ack with
    //> different combinations of cyc/stb/we/adr (e.g. a memory acks on stb
    //> alone, a FSM slave on adr as it matches the request).
    soci ack : Bit dependson cyc, stb, we, adr
    //> Error: the slave asserts this on an error.
    //>
    //> Decoding errors are qualified by the request signals, including sel
    //> (a slave may flag unsupported byte lanes).
    soci err : Bit dependson cyc, stb, we, adr, sel
    //> Read data.
    //>
    //> Read data is a function of the address and whether a read is being
    //> requested at all (cyc/stb/we).
    soci dat_rd : Word[32] dependson cyc, stb, we, adr
}

//> Arbiter state: which master is being served by an arbiter.
union type Serving {
    //> No master currently being served.
    Idle()
    //> Serving master 0.
    ServingClient0()
    //> Serving master 1.
    ServingClient1()
}

//> Round-robin priority state for the arbiter.
union type Priority {
    //> Client 0 has priority on the next tie.
    Client0First()
    //> Client 1 has priority on the next tie.
    Client1First()
}

//> Server-select state: which slave is being served by a mux.
union type SelState {
    Server0()
    Server1()
    Server2()
}

pub mod WbMux13 {
    client socket server_0 of Wishbone
    client socket server_1 of Wishbone
    client socket server_2 of Wishbone

    //> Server socket for the upstream master.
    //>
    //> Routes strobe/cycle to the selected slave, broadcasts the
    //> remaining master signals, muxes the response, and generates
    //> an error on decode_err.
    server socket client_0 of Wishbone {
        server_0.cyc := it.cyc && serving == @Server0()
        server_1.cyc := it.cyc && serving == @Server1()
        server_2.cyc := it.cyc && serving == @Server2()

        server_0.stb := it.stb && serving == @Server0()
        server_1.stb := it.stb && serving == @Server1()
        server_2.stb := it.stb && serving == @Server2()

        it.err := server_0.err || server_1.err || server_2.err
        it.ack := match serving {
            with @Server0() => server_0.ack
            with @Server1() => server_1.ack
            with @Server2() => server_2.ack
        }

        server_0.we := it.we && serving == @Server0()
        server_1.we := it.we && serving == @Server1()
        server_2.we := it.we && serving == @Server2()

        server_0.adr := zext(it.adr[29..0])
        server_1.adr := zext(it.adr[29..0])
        server_2.adr := zext(it.adr[29..0])

        server_0.sel := it.sel
        server_1.sel := it.sel
        server_2.sel := it.sel

        server_0.dat_wr := it.dat_wr
        server_1.dat_wr := it.dat_wr
        server_2.dat_wr := it.dat_wr

        it.dat_rd := match serving {
            with @Server0() => server_0.dat_rd
            with @Server1() => server_1.dat_rd
            with @Server2() => server_2.dat_rd
        }
    }

    //> Registered slave-select state (used to mux read-data).
    wire serving : SelState {
        it := match client_0.adr[32..29] {
            with 0b001 => @Server0()
            with 0b010 => @Server1()
            with 0b100 => @Server2()
            else => dontcare
        }
    }
}

//> 2-client × 3-server Wishbone crossbar.
//>
//> Each client is routed to a server by comparing the top 3 address
//> bits, exactly as in WbMux13:
//>
//>   0x2 → server_0 (SPI,  0x2000_0000)
//>   0x4 → server_1 (UART, 0x4000_0000)
//>   0x8 → server_2 (RAM,  0x8000_0000)
//>
//> Each server has its own arbiter, so two clients may use two
//> different servers in the same cycle.  When both clients request
//> the same server, the arbiter serializes them using round-robin
//> priority: completing a grant flips that server's priority for the
//> next tie.
//>
//> Grants are registered: a server's arbiter latches
//> @ServingClientN() when it accepts a request and returns to
//> @Idle() when the granted client stops requesting that server
//> (dropping cyc or switching its address to another slave).  Clients
//> therefore see a one-cycle latency before ack, which is ordinary
//> Wishbone wait-state behavior.
pub mod WbCrossbar23 {
    incoming clock : Clock
    incoming reset : Reset

    // ─── Address decode ──────────────────────────────────────────────
    //> One hit bit per (client, server).  Deliberately *not* an enum
    //> with a `dontcare` else-arm: these bits sit on the control path
    //> (request → grant → ack → CPU stall), and `dontcare` is "any
    //> value" — a simulator may legally pick a different value at each
    //> use site, which turned a one-cycle idle gap into a spurious ack
    //> that let the CPU leave Fetch with no data (the pure-Virdant
    //> simulator did exactly that; Verilog's x→0 masked it).  An
    //> unmapped address now simply hits no server.
    wire hit_0_0 : Bit { it := client_0.adr[32..29] == 0b001w3 }
    wire hit_0_1 : Bit { it := client_0.adr[32..29] == 0b010w3 }
    wire hit_0_2 : Bit { it := client_0.adr[32..29] == 0b100w3 }

    wire hit_1_0 : Bit { it := client_1.adr[32..29] == 0b001w3 }
    wire hit_1_1 : Bit { it := client_1.adr[32..29] == 0b010w3 }
    wire hit_1_2 : Bit { it := client_1.adr[32..29] == 0b100w3 }

    // ─── Requests ────────────────────────────────────────────────────
    wire client_0_request_0 : Bit {
        it := client_0.cyc && client_0.stb && hit_0_0
    }
    wire client_0_request_1 : Bit {
        it := client_0.cyc && client_0.stb && hit_0_1
    }
    wire client_0_request_2 : Bit {
        it := client_0.cyc && client_0.stb && hit_0_2
    }

    wire client_1_request_0 : Bit {
        it := client_1.cyc && client_1.stb && hit_1_0
    }
    wire client_1_request_1 : Bit {
        it := client_1.cyc && client_1.stb && hit_1_1
    }
    wire client_1_request_2 : Bit {
        it := client_1.cyc && client_1.stb && hit_1_2
    }

    // ─── Active grants ───────────────────────────────────────────────
    //> Whether server_N is currently being accessed by its granted
    //> client: the grant is live only while that client keeps
    //> requesting *this* server (cyc && stb with an address that still
    //> decodes to this server).
    //>
    //> A master may hold cyc across back-to-back transactions to
    //> different slaves — the CPU goes straight from an SPI-flash
    //> instruction fetch to a RAM/UART data access without ever
    //> dropping cyc.  Tying the grant to the client's current request
    //> (rather than merely to cyc) makes the arbiter release the old
    //> server as soon as the master moves on, so at most one arbiter
    //> grants any given client at a time and the client-facing ack mux
    //> — which can name only one server — stays unambiguous.
    //>
    //> These wires also gate the server-facing cyc/stb, so a slave
    //> never sees a phantom transaction during the one cycle between
    //> the master switching away and the grant being released (an
    //> ungated SPI controller would start a bogus read there and later
    //> ack it into an unrelated fetch).
    wire serve_0 : Bit {
        it := match serving_0 {
            with @ServingClient0() => client_0.cyc && client_0.stb && hit_0_0
            with @ServingClient1() => client_1.cyc && client_1.stb && hit_1_0
            else => false
        }
    }

    wire serve_1 : Bit {
        it := match serving_1 {
            with @ServingClient0() => client_0.cyc && client_0.stb && hit_0_1
            with @ServingClient1() => client_1.cyc && client_1.stb && hit_1_1
            else => false
        }
    }

    wire serve_2 : Bit {
        it := match serving_2 {
            with @ServingClient0() => client_0.cyc && client_0.stb && hit_0_2
            with @ServingClient1() => client_1.cyc && client_1.stb && hit_1_2
            else => false
        }
    }

    // ─── Per-server arbiters ─────────────────────────────────────────
    // Registered grant state, one per server.
    //
    // NOTE: written with explicit `case <cond>` arms — a statement-level
    // `else match` arm is silently dropped by the compiler, which left
    // the arbiters stuck in @Idle() (no server ever saw cyc).
    reg serving_0 : Serving {
        if {
            when reset {
                it <= @Idle()
            }
            when it == @ServingClient0() && !serve_0 {
                it <= @Idle()
            }
            when it == @ServingClient1() && !serve_0 {
                it <= @Idle()
            }
            when it == @Idle() && client_0_request_0 && (priority_0 == @Client0First() || !client_1_request_0) {
                it <= @ServingClient0()
            }
            when it == @Idle() && client_1_request_0 {
                it <= @ServingClient1()
            }
        }
    }

    reg serving_1 : Serving {
        if {
            when reset {
                it <= @Idle()
            }
            when it == @ServingClient0() && !serve_1 {
                it <= @Idle()
            }
            when it == @ServingClient1() && !serve_1 {
                it <= @Idle()
            }
            when it == @Idle() && client_0_request_1 && (priority_1 == @Client0First() || !client_1_request_1) {
                it <= @ServingClient0()
            }
            when it == @Idle() && client_1_request_1 {
                it <= @ServingClient1()
            }
        }
    }

    reg serving_2 : Serving {
        if {
            when reset {
                it <= @Idle()
            }
            when it == @ServingClient0() && !serve_2 {
                it <= @Idle()
            }
            when it == @ServingClient1() && !serve_2 {
                it <= @Idle()
            }
            when it == @Idle() && client_0_request_2 && (priority_2 == @Client0First() || !client_1_request_2) {
                it <= @ServingClient0()
            }
            when it == @Idle() && client_1_request_2 {
                it <= @ServingClient1()
            }
        }
    }

    //> Grant release: the granted client has finished (or moved on
    //> from) its transaction with this server.
    wire release_0 : Bit {
        it := !serve_0
    }
    wire release_1 : Bit {
        it := !serve_1
    }
    wire release_2 : Bit {
        it := !serve_2
    }

    // Round-robin priority, one per server.  Flips on grant release so
    // that a client cannot starve the other on a contended server.
    reg priority_0 : Priority {
        if {
            when reset {
                it <= @Client0First()
            }
            when release_0 {
                it <= match it {
                    with @Client0First() => @Client1First()
                    else => @Client0First()
                }
            }
        }
    }

    reg priority_1 : Priority {
        if {
            when reset {
                it <= @Client0First()
            }
            when release_1 {
                it <= match it {
                    with @Client0First() => @Client1First()
                    else => @Client0First()
                }
            }
        }
    }

    reg priority_2 : Priority {
        if {
            when reset {
                it <= @Client0First()
            }
            when release_2 {
                it <= match it {
                    with @Client0First() => @Client1First()
                    else => @Client0First()
                }
            }
        }
    }

    // ─── Grant wiring ────────────────────────────────────────────────
    //> Which server (if any) currently grants each client, as one bit
    //> per server.  At most one is set (a client requests one address
    //> at a time, and a grant is released as soon as the request moves
    //> away).  No `dontcare` here either — see the address-decode note.
    wire grant_0_0 : Bit { it := serving_0 == @ServingClient0() }
    wire grant_0_1 : Bit { it := serving_1 == @ServingClient0() }
    wire grant_0_2 : Bit { it := serving_2 == @ServingClient0() }

    wire grant_1_0 : Bit { it := serving_0 == @ServingClient1() }
    wire grant_1_1 : Bit { it := serving_1 == @ServingClient1() }
    wire grant_1_2 : Bit { it := serving_2 == @ServingClient1() }

    // ─── Server-facing drivers ───────────────────────────────────────
    // Each server sees the signals of whichever client was granted to
    // it, gated by that client's live request (serve_N); ungranted
    // servers are idle.
    client socket server_0 of Wishbone {
        it.cyc    := serve_0
        it.stb    := serve_0
        it.we     := match serving_0 {
            with @ServingClient0() => client_0.we
            with @ServingClient1() => client_1.we
            else => false
        }
        it.adr    := match serving_0 {
            with @ServingClient0() => zext(client_0.adr[29..0])
            with @ServingClient1() => zext(client_1.adr[29..0])
            else => dontcare
        }
        it.sel    := match serving_0 {
            with @ServingClient0() => client_0.sel
            with @ServingClient1() => client_1.sel
            else => dontcare
        }
        it.dat_wr := match serving_0 {
            with @ServingClient0() => client_0.dat_wr
            with @ServingClient1() => client_1.dat_wr
            else => dontcare
        }
    }

    client socket server_1 of Wishbone {
        it.cyc    := serve_1
        it.stb    := serve_1
        it.we     := match serving_1 {
            with @ServingClient0() => client_0.we
            with @ServingClient1() => client_1.we
            else => false
        }
        it.adr    := match serving_1 {
            with @ServingClient0() => zext(client_0.adr[29..0])
            with @ServingClient1() => zext(client_1.adr[29..0])
            else => dontcare
        }
        it.sel    := match serving_1 {
            with @ServingClient0() => client_0.sel
            with @ServingClient1() => client_1.sel
            else => dontcare
        }
        it.dat_wr := match serving_1 {
            with @ServingClient0() => client_0.dat_wr
            with @ServingClient1() => client_1.dat_wr
            else => dontcare
        }
    }

    client socket server_2 of Wishbone {
        it.cyc    := serve_2
        it.stb    := serve_2
        it.we     := match serving_2 {
            with @ServingClient0() => client_0.we
            with @ServingClient1() => client_1.we
            else => false
        }
        it.adr    := match serving_2 {
            with @ServingClient0() => zext(client_0.adr[29..0])
            with @ServingClient1() => zext(client_1.adr[29..0])
            else => dontcare
        }
        it.sel    := match serving_2 {
            with @ServingClient0() => client_0.sel
            with @ServingClient1() => client_1.sel
            else => dontcare
        }
        it.dat_wr := match serving_2 {
            with @ServingClient0() => client_0.dat_wr
            with @ServingClient1() => client_1.dat_wr
            else => dontcare
        }
    }

    // ─── Client-facing response muxes ────────────────────────────────
    // Each client sees ack/err/read-data only from the server that
    // granted it.  Read data defaults to zero when nothing is granted;
    // the master only samples it alongside ack.
    server socket client_0 of Wishbone {
        it.ack    := (grant_0_0 && server_0.ack)
        || (grant_0_1 && server_1.ack)
        || (grant_0_2 && server_2.ack)
        it.err    := (grant_0_0 && server_0.err)
        || (grant_0_1 && server_1.err)
        || (grant_0_2 && server_2.err)
        it.dat_rd := if {
            when grant_0_0 => server_0.dat_rd
            when grant_0_1 => server_1.dat_rd
            when grant_0_2 => server_2.dat_rd
            else => 0w32
        }
    }

    server socket client_1 of Wishbone {
        it.ack    := (grant_1_0 && server_0.ack)
        || (grant_1_1 && server_1.ack)
        || (grant_1_2 && server_2.ack)
        it.err    := (grant_1_0 && server_0.err)
        || (grant_1_1 && server_1.err)
        || (grant_1_2 && server_2.err)
        it.dat_rd := if {
            when grant_1_0 => server_0.dat_rd
            when grant_1_1 => server_1.dat_rd
            when grant_1_2 => server_2.dat_rd
            else => 0w32
        }
    }
}
