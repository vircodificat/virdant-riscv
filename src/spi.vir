/// SPI flash controller.
///
/// This package provides an SPI master that reads from a SPI NOR flash
/// using the standard 0x03 (READ) command, and a Spi socket definition.

/// SPI flash controller FSM state.
enum type State width 4 {
    /// Idle: waiting for a read request.
    Idle = 1
    /// Send: transmitting the command and address to the flash.
    Send = 2
    /// Recv: receiving data from the flash.
    Recv = 4
    /// Done: data available for the requesting master.
    Done = 8
}

/// SPI bus socket.
///
/// Signals are from the master's perspective: cs (chip-select, active-low),
/// clk (serial clock), do (master-out, slave-in), di (master-in, slave-out).
socket Spi {
    /// Chip-select (active-low).
    cosi cs : Bit
    /// Serial clock.
    cosi clk : Bit
    /// Master data output (MOSI).
    cosi do : Bit
    /// Slave data input (MISO).
    ciso di : Bit
}

/// SPI flash memory reader.
///
/// Reads 32-bit words from an SPI NOR flash using the 0x03 command.
/// Provides a simple memory-mapped read interface to an attached master.
mod SpiFlash {
    /// Global clock.
    incoming clock : Clock
    /// Global reset (active-high).
    incoming reset : Reset

    /// SPI bus client socket.
    client socket spi of Spi

    /// Memory-mapped read address.
    incoming mem_addr : Word[32]
    /// Read-enable strobe from the master.
    incoming mem_read_enable : Bit

    /// Read data output (valid when `mem_read_data_valid` is high).
    outgoing mem_read_data : Word[32]
    /// Read-data valid indicator.
    outgoing mem_read_data_valid : Bit

    /// FSM state register.
    reg state : State on clock

    /// Serial send buffer (command + address to transmit).
    reg send_buffer : Word[32] on clock
    /// Serial receive buffer (incoming bits from the flash).
    reg recv_buffer : Word[32] on clock
    /// Accumulated read data (built up during the Recv state).
    reg data : Word[32] on clock // for DONE state
    data <=
        if half_clock {
        word(recv_buffer[31..0], 0w1) | word(0w31, spi.di)
    } else {
        data
    }

    /// Count of bits sent (0–31).
    reg bits_sent : Word[6] on clock
    /// Count of bits received (0–31).
    reg bits_read : Word[6] on clock

    /// Half-clock divider. Toggles every cycle to produce SPI clock edges.
    reg half_clock : Bit on clock

    // Toggle half_clock every cycle.
    half_clock <= if reset {
        false
    } else {
        !half_clock
    }

    /// SPI clock register (inverted every cycle when active).
    reg spi_clk_reg : Bit on clock
    spi.clk := spi_clk_reg
    // Invert SPI clock every cycle.
    spi_clk_reg <= !spi_clk_reg

    // FSM next-state logic.
    state <=
        if reset {
        #Idle
    } else {
        if state == #Idle { // IDLE
            if mem_read_enable {
                #Send
            } else {
                #Idle
            }
        } else if state == #Send { // SEND
            if bits_sent < 31 {
                #Send
            } else {
                #Recv
            }
        } else if state == #Recv { // RECV
            if bits_read < 31 {
                #Recv
            } else {
                #Done
            }
        } else {
            #Idle
        }
    }

    // Shift out the send buffer (0x03 command + 24-bit address).
    send_buffer <=
        if half_clock {
        if state == #Idle { // IDLE
            word(0x03w8, mem_addr[24..0])
        } else if state == #Send {
            word(send_buffer[31..0], 0w1)
        } else {
            0
        }
    } else {
        send_buffer
    }

    // Shift in the receive buffer.
    recv_buffer <=
        if half_clock {
        if state == #Send { // SEND
            0
        } else if state == #Send { // SEND
            word(recv_buffer[31..0], spi.di)

        } else {
            0
        }
    } else {
        recv_buffer
    }

    // Count transmitted bits.
    bits_sent <=
        if half_clock {
        if state == #Idle { // IDLE
            0
        } else if state == #Send { // SEND
            bits_sent + 1
        } else {
            0
        }
    } else {
        bits_sent
    }

    // Count received bits.
    bits_read <=
        if half_clock {
        if state == #Send { // SEND
            0
        } else if state == #Send { // SEND
            bits_read + 1

        } else {
            0
        }
    } else {
        bits_read
    }

    // Chip-select: active-low, asserted during Send/Recv.
    spi.cs :=
        if reset {
        true
    } else if state == #Idle { // IDLE
        true
    } else if state == #Done { // DONE
        true
    } else {
        false
    }

    // Master data output: most-significant bit of send_buffer during Send, idle-high otherwise.
    spi.do :=
        if reset {
        true
    } else {
        if state == #Send { // SEND
            send_buffer[31]
        } else {
            true
        }
    }

    // Read data output (big-endian byte swap for 32-bit word).
    mem_read_data :=
        if state == #Done { // DONE
        word(data[8..0], data[16..8], data[24..16], data[32..24])
    } else {
        0xffffffffw32
    }

    // Read data valid: high only in the Done state.
    mem_read_data_valid := state == #Done // DONE
}
